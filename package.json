{
  "name": "harish-portfolio-next",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "build": "astro build",
    "preview": "astro preview --host 127.0.0.1",
    "check": "astro check",
    "test": "node --test tests/*.test.mjs scripts/site.test.mjs",
    "validate": "npm run check && npm run build && npm test",
    "format": "prettier --write .",
    "prebuild": "node scripts/blog.mjs",
    "blog:refresh": "node scripts/blog.mjs --strict",
    "test:unit": "node --test tests/*.test.mjs",
    "asset:delorean": "node scripts/render-delorean.mjs"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/manrope": "5.3.0",
    "astro": "7.3.5"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "fast-xml-parser": "^5.11.1",
    "fast-xml-validator": "1.4.2",
    "prettier": "3.6.2",
    "prettier-plugin-astro": "0.14.1",
    "sharp": "0.35.4",
    "typescript": "5.9.3"
  }
}
