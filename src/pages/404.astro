---
import Layout from "../layouts/Layout.astro";
import Icon from "../components/Icon.astro";
---

<Layout title="Page not found — Harish Thangadurai" noindex
  ><section class="container not-found">
    <p class="eyebrow">HTTP 404 / ROUTE NOT FOUND</p><h1>
      This request took<br /><span class="muted">a wrong turn.</span>
    </h1><p>
      The page you're looking for isn't here. Let's get you back to a known
      route.
    </p><a
      class="button button-primary"
      href="/">Back to the portfolio <Icon name="arrow" size={18} /></a
    >
  </section></Layout
>
