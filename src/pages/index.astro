---
import Layout from "../layouts/Layout.astro";
import Icon from "../components/Icon.astro";
import Portrait from "../components/Portrait.astro";
import ProjectDiagram from "../components/ProjectDiagram.astro";
import Contact from "../components/Contact.astro";
import Lab from "../components/Lab.astro";
import {
  profile,
  experience,
  education,
  skills,
  earlierSkills,
} from "../data/profile";
import { projects, otherProjects } from "../data/projects";
import blog from "../data/blog.json";
const started = new Date(`${profile.fullTimeSince}T00:00:00Z`);
const today = new Date();
const anniversaryPending =
  today.getUTCMonth() < started.getUTCMonth() ||
  (today.getUTCMonth() === started.getUTCMonth() &&
    today.getUTCDate() < started.getUTCDate());
const experienceYears =
  today.getUTCFullYear() -
  started.getUTCFullYear() -
  Number(anniversaryPending);
---

<Layout>
  <section class="hero container" aria-labelledby="hero-heading">
    <div class="hero-copy">
      <p class="eyebrow">
        <span class="eyebrow-line" aria-hidden="true"></span> SITE RELIABILITY ·
        DEVOPS · CURIOSITY
      </p><h1 id="hero-heading">
        Harish<br />Thangadurai<span class="name-period">.</span>
      </h1><p class="hero-role">I make systems <span>make sense.</span></p><p
        class="hero-description"
      >
        Site Reliability Engineer at <a
          target="_blank"
          rel="noopener noreferrer"
          href="https://nielseniq.com/">NielsenIQ</a
        >.<br />Building reliable infrastructure, improving deployments, and
        understanding what happens underneath.
      </p><div class="hero-actions">
        <a
          class="button button-primary"
          href="#work">View my projects <Icon name="arrow" size={18} /></a
        ><a
          target="_blank"
          rel="noopener noreferrer"
          class="quiet-link"
          href={profile.github}><Icon name="github" size={18} /> GitHub</a
        ><a
          target="_blank"
          rel="noopener noreferrer"
          class="quiet-link"
          href={profile.linkedin}><Icon name="linkedin" size={18} /> LinkedIn</a
        >
      </div>
    </div>
    <Portrait />
    <div class="hero-bottom">
      <span class="mono">Infrastructure. Intention. Iteration.</span><a
        href="#work"
        class="scroll-cue">Explore projects <span aria-hidden="true">↓</span></a
      >
    </div>
  </section>
  <section id="work" class="container section" aria-labelledby="work-heading">
    <div class="section-heading split-heading">
      <div>
        <p class="eyebrow">01 / PERSONAL PROJECTS</p><h2 id="work-heading">
          Projects
        </h2>
      </div><p class="section-lead">
        A few things I build and operate outside my day job. Real
        infrastructure, open repositories, and plenty of lessons along the way.
      </p>
    </div>
    <div class="project-list">
      {
        projects.map((project, i) => (
          <article class="project-row">
            <>
              <a
                class="project-visual-link"
                href={`/projects/${project.slug}/`}
                aria-label={`Explore ${project.name}`}
              >
                <ProjectDiagram type={project.slug} />
              </a>
              <div class="project-copy">
                <>
                  <span class="project-number mono">
                    0{i + 1} <span>/ {project.category}</span>
                  </span>
                  <h3>
                    <a
                      href={`/projects/${project.slug}/`}
                    >
                      {project.headline}
                      <Icon name="arrow" size={24} />
                    </a>
                  </h3>
                  <p>{project.description}</p>
                  <ul class="tag-list">
                    {project.tags.map((tag) => (
                      <li>{tag}</li>
                    ))}
                  </ul>
                  <div class="project-actions">
                    <>
                      <a
                        href={`/projects/${project.slug}/`}
                      >
                        Project details <span aria-hidden="true">→</span>
                      </a>
                      <a
                        target="_blank"
                        rel="noopener noreferrer"
                        class="repo-link"
                        href={project.repo}
                      >
                        <Icon name="github" size={16} /> Source
                      </a>
                    </>
                  </div>
                </>
              </div>
            </>
          </article>
        ))
      }
    </div>
    <a
      class="archive-link"
      href="/projects/"
      >View all projects <span class="mono"
        >{projects.length + otherProjects.length} PROJECTS</span
      ><Icon name="arrow" size={20} /></a
    >
  </section>
  <section
    id="journey"
    class="container section journey-section"
    aria-labelledby="journey-heading"
  >
    <div class="section-heading">
      <p class="eyebrow">02 / CAREER TIMELINE</p><h2 id="journey-heading">
        Experience
      </h2><p class="experience-summary">
        <strong>{experienceYears}+ years</strong> of professional experience
      </p><p class="section-lead">
        My work centres on repeatable deployments, maintainable infrastructure,
        and understanding system behaviour when something goes wrong.
      </p><a
        target="_blank"
        rel="noopener noreferrer"
        class="quiet-link"
        href={profile.linkedin}>View LinkedIn <Icon name="arrow" size={16} /></a
      >
    </div>
    <div class="timeline">
      {
        experience.map((item) => (
          <article
            class:list={["timeline-item", { "is-current": item.current }]}
          >
            <>
              <div class="timeline-meta">
                <span class="mono">{item.date}</span>
                {item.current && (
                  <span class="current-badge">Current role</span>
                )}
              </div>
              <h3>
                <a target="_blank" rel="noopener noreferrer" href={item.url}>
                  {item.company}
                  <Icon name="arrow" size={16} />
                </a>
              </h3>
              <p class="timeline-role">{item.role}</p>
              <p class="timeline-detail">{item.detail}</p>
            </>
          </article>
        ))
      }
      <details class="education">
        <summary>Education <Icon name="chevron" size={18} /></summary><div>
          {
            education.map((item) => (
              <article>
                <>
                  <span class="mono muted">{item.date}</span>
                  <h4>{item.title}</h4>
                  <a target="_blank" rel="noopener noreferrer" href={item.url}>
                    {item.place} <span aria-hidden="true">↗</span>
                  </a>
                </>
              </article>
            ))
          }
        </div>
      </details>
    </div>
  </section>
  <section id="about" class="container section" aria-labelledby="about-heading">
    <div class="about-layout">
      <div class="section-heading">
        <p class="eyebrow">03 / THE PERSON BEHIND THE SYSTEMS</p><h2
          id="about-heading"
        >
          About me
        </h2>
      </div><div class="about-content">
        <div class="about-copy">
          <p>
            I'm an engineer who likes understanding how things work, especially
            when they don't. My interests sit at the intersection of
            infrastructure, reliability, observability, and performance.
          </p><p>
            Outside work, I run self-hosted services and Kubernetes clusters in
            my homelab. It's a place to experiment with deployments, stateful
            workloads, networking, and recovery—and to learn from the parts that
            don't go to plan.
          </p><p>
            I write down what I learn on <a
              target="_blank"
              rel="noopener noreferrer"
              href={profile.blog}>Harish's Tech Bytes</a
            >, so the next person has a little less figuring out to do.
          </p><blockquote>
            “If it works manually, automate it.<br />If it breaks, understand
            it.”
          </blockquote>
        </div>
      </div>
      <Lab />
    </div>
  </section>
  <section
    id="toolkit"
    class="container section"
    aria-labelledby="toolkit-heading"
  >
    <div class="section-heading split-heading">
      <div>
        <p class="eyebrow">04 / TECHNICAL EXPERTISE</p><h2 id="toolkit-heading">
          Skills &amp; tools
        </h2>
      </div>
      <p class="section-lead">
        The technologies I use to build infrastructure, deliver applications,
        and understand how systems behave.
      </p>
    </div>
    <div class="skills-grid">
      {
        skills.map((group, index) => (
          <div class="skill-category">
            <div class="skill-heading">
              <>
                <span class="mono" aria-hidden="true">
                  0{index + 1}
                </span>
                <h3>{group.title}</h3>
              </>
            </div>
            <ul class="skill-list">
              {group.items.map((skill) => (
                <li>{skill}</li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
    <div class="skill-category earlier-skills">
      <h3>Earlier development background</h3>
      <ul class="skill-list">
        {earlierSkills.map((skill) => <li>{skill}</li>)}
      </ul>
    </div>
  </section>
  <section
    id="writing"
    class="container section"
    aria-labelledby="writing-heading"
  >
    <div class="section-heading split-heading">
      <div>
        <p class="eyebrow">05 / GUIDES &amp; LESSONS</p><h2
          id="writing-heading"
        >
          Blogs &amp; writing
        </h2>
      </div>
      <p class="section-lead">
        Notes from building, running, and troubleshooting the systems I work
        with.
      </p>
    </div>
    <h3 class="latest-articles-heading">Latest articles</h3>
    <div class="latest-articles">
      {
        blog.articles.map((article) => (
          <a
            target="_blank"
            rel="noopener noreferrer"
            class="article-card"
            href={article.url}
          >
            <time datetime={article.date}>
              {new Date(article.date + "T00:00:00Z").toLocaleDateString(
                "en-GB",
                {
                  day: "numeric",
                  month: "short",
                  year: "numeric",
                  timeZone: "UTC",
                },
              )}
            </time>
            <h4>{article.title}</h4>
            <span>
              Read article <Icon name="arrow" size={18} />
            </span>
          </a>
        ))
      }
    </div>
    <div class="writing-links">
      <span class="muted">More writing</span>
      <a
        target="_blank"
        rel="noopener noreferrer"
        class="quiet-link"
        href={profile.blog}
      >
        Harish’s Tech Bytes <Icon name="arrow" size={18} />
      </a>
      <a
        target="_blank"
        rel="noopener noreferrer"
        class="quiet-link"
        href={profile.medium}
      >
        Medium <Icon name="arrow" size={18} />
      </a>
    </div>
  </section>
  <Contact />
</Layout>
