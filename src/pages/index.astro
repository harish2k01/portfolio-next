---
import Layout from "../layouts/Layout.astro";
import Icon from "../components/Icon.astro";
import Portrait from "../components/Portrait.astro";
import ProjectDiagram from "../components/ProjectDiagram.astro";
import Contact from "../components/Contact.astro";
import Lab from "../components/Lab.astro";
import { profile, experience, education, skills } from "../data/profile";
import { projects } from "../data/projects";
import blog from "../data/blog.json";
---

<Layout>
  <section class="hero container" aria-labelledby="hero-heading">
    <div class="hero-copy">
      <p class="eyebrow">
        <span class="eyebrow-line" aria-hidden="true"></span> SITE RELIABILITY ·
        DEVOPS · CURIOSITY
      </p><h1 id="hero-heading">
        Harish<br />Thangadurai<span class="name-period">.</span>
      </h1><p class="hero-role">I make systems <span>make sense.</span></p><p
        class="hero-description"
      >
        Site Reliability Engineer at <a href="https://nielseniq.com/"
          >NielsenIQ</a
        >.<br />Building reliable infrastructure, automating the repetitive, and
        understanding what happens underneath.
      </p><div class="hero-actions">
        <a class="button button-primary" href="#work"
          >View my projects <Icon name="arrow" size={18} /></a
        ><a class="quiet-link" href={profile.github}
          ><Icon name="github" size={18} /> GitHub</a
        ><a class="quiet-link" href={profile.linkedin}
          ><Icon name="linkedin" size={18} /> LinkedIn</a
        >
      </div>
    </div>
    <Portrait />
    <div class="hero-bottom">
      <span class="mono">Infrastructure. Intention. Iteration.</span><a
        href="#work"
        class="scroll-cue">Explore projects <span aria-hidden="true">↓</span></a
      >
    </div>
  </section>
  <section id="work" class="container section" aria-labelledby="work-heading">
    <div class="section-heading split-heading">
      <div>
        <p class="eyebrow">01 / PERSONAL PROJECTS</p><h2 id="work-heading">
          Projects
        </h2>
      </div><p class="section-lead">
        A few things I build and operate outside my day job. Real
        infrastructure, open repositories, and plenty of lessons along the way.
      </p>
    </div>
    <div class="project-list">
      {
        projects.slice(0, 3).map((project, i) => (
          <article class="project-row">
            <>
              <a
                class="project-visual-link"
                href={`/projects/${project.slug}/`}
                aria-label={`Explore ${project.name}`}
              >
                <ProjectDiagram type={project.slug} />
              </a>
              <div class="project-copy">
                <>
                  <span class="project-number mono">
                    0{i + 1} <span>/ {project.category}</span>
                  </span>
                  <h3>
                    <a href={`/projects/${project.slug}/`}>
                      {project.headline}
                      <Icon name="arrow" size={24} />
                    </a>
                  </h3>
                  <p>{project.description}</p>
                  <ul class="tag-list">
                    {project.tags.map((tag) => (
                      <li>{tag}</li>
                    ))}
                  </ul>
                  <div class="project-actions">
                    <>
                      <a href={`/projects/${project.slug}/`}>
                        Project details <span aria-hidden="true">→</span>
                      </a>
                      <a class="repo-link" href={project.repo}>
                        <Icon name="github" size={16} /> Source
                      </a>
                    </>
                  </div>
                </>
              </div>
            </>
          </article>
        ))
      }
    </div>
    <a class="project-extra" href="/projects/grafana-dashboards/"
      ><span class="extra-icon" aria-hidden="true">▥</span><div>
        <span class="mono">OBSERVABILITY PROJECT</span><h3>
          Grafana Monitoring Dashboards
        </h3>
      </div><Icon name="arrow" size={24} /></a
    >
    <a class="archive-link" href="/projects/"
      >View all projects <span class="mono">11 PROJECTS</span><Icon
        name="arrow"
        size={20}
      /></a
    >
  </section>
  <section
    id="journey"
    class="container section journey-section"
    aria-labelledby="journey-heading"
  >
    <div class="section-heading">
      <p class="eyebrow">02 / CAREER TIMELINE</p><h2 id="journey-heading">
        Experience
      </h2><p class="section-lead">
        From software and quality engineering to site reliability. Each step
        adds another way to understand a system.
      </p><a class="quiet-link" href={profile.linkedin}
        >View LinkedIn <Icon name="arrow" size={16} /></a
      >
    </div>
    <div class="timeline">
      {
        experience.map((item) => (
          <article
            class:list={["timeline-item", { "is-current": item.current }]}
          >
            <>
              <div class="timeline-meta">
                <span class="mono">{item.date}</span>
                {item.current && (
                  <span class="current-badge">Current role</span>
                )}
              </div>
              <h3>
                <a href={item.url}>
                  {item.company}
                  <Icon name="arrow" size={16} />
                </a>
              </h3>
              <p class="timeline-role">{item.role}</p>
              <p class="timeline-detail">{item.detail}</p>
            </>
          </article>
        ))
      }
      <details class="education">
        <summary>Education <Icon name="chevron" size={18} /></summary><div>
          {
            education.map((item) => (
              <article>
                <>
                  <span class="mono muted">{item.date}</span>
                  <h4>{item.title}</h4>
                  <a href={item.url}>
                    {item.place} <span aria-hidden="true">↗</span>
                  </a>
                </>
              </article>
            ))
          }
        </div>
      </details>
    </div>
  </section>
  <section id="about" class="container section" aria-labelledby="about-heading">
    <div class="about-layout">
      <div class="section-heading">
        <p class="eyebrow">03 / THE PERSON BEHIND THE SYSTEMS</p><h2
          id="about-heading"
        >
          About me
        </h2>
      </div><div class="about-copy">
        <p>
          I'm an engineer who likes understanding how things work, especially
          when they don't. My interests sit at the intersection of
          infrastructure, automation, observability, and performance.
        </p><p>
          Outside work, I run self-hosted services and Kubernetes clusters in my
          homelab. It's a place to experiment with deployments, stateful
          workloads, networking, and recovery—and to learn from the parts that
          don't go to plan.
        </p><p>
          I write down what I learn on <a href={profile.blog}
            >Harish's Tech Bytes</a
          >, so the next person has a little less figuring out to do.
        </p><blockquote>
          “If it works manually, automate it.<br />If it breaks, understand it.”
        </blockquote>
      </div>
    </div>
    <Lab />
  </section>
  <section
    id="toolkit"
    class="container section"
    aria-labelledby="toolkit-heading"
  >
    <div class="section-heading split-heading">
      <div>
        <p class="eyebrow">04 / TECHNICAL EXPERTISE</p><h2 id="toolkit-heading">
          Skills &amp; tools
        </h2>
      </div>
      <p class="section-lead">
        The technologies I use across infrastructure, automation, observability,
        and software development.
      </p>
    </div>
    <div class="skills-grid">
      {
        skills.map((group) => (
          <div class="skill-category">
            <h3>{group.title}</h3>
            <ul class="skill-list">
              {group.items.map((skill) => (
                <li>{skill}</li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </section>
  <section
    id="writing"
    class="container section"
    aria-labelledby="writing-heading"
  >
    <div class="section-heading split-heading">
      <div>
        <p class="eyebrow">05 / GUIDES &amp; LESSONS</p><h2
          id="writing-heading"
        >
          Blogs &amp; writing
        </h2>
      </div>
      <p class="section-lead">
        I share what I learn about Kubernetes, self-hosting, automation, and
        troubleshooting. Find my articles on either platform.
      </p>
    </div>
    <h3 class="latest-articles-heading">Latest articles</h3>
    <div class="latest-articles">
      {
        blog.articles.map((article) => (
          <a class="article-card" href={article.url}>
            <time datetime={article.date}>
              {new Date(article.date + "T00:00:00Z").toLocaleDateString(
                "en-GB",
                {
                  day: "numeric",
                  month: "short",
                  year: "numeric",
                  timeZone: "UTC",
                },
              )}
            </time>
            <h4>{article.title}</h4>
            <span>
              Read on Tech Bytes <Icon name="arrow" size={18} />
            </span>
          </a>
        ))
      }
    </div>
    <div class="writing-platforms">
      <a class="writing-platform" href={profile.blog}>
        <span class="mono">PERSONAL BLOG</span>
        <h3>Harish’s Tech Bytes <Icon name="arrow" size={24} /></h3>
        <p>
          Practical guides and notes from my engineering work and homelab
          experiments.
        </p>
        <span class="platform-link"
          >Read Tech Bytes <span aria-hidden="true">↗</span></span
        >
      </a>
      <a class="writing-platform" href={profile.medium}>
        <span class="mono">MEDIUM</span>
        <h3>Harish on Medium <Icon name="arrow" size={24} /></h3>
        <p>More of my technical writing, collected on my Medium profile.</p>
        <span class="platform-link"
          >Read on Medium <span aria-hidden="true">↗</span></span
        >
      </a>
    </div>
  </section>
  <Contact />
</Layout>
