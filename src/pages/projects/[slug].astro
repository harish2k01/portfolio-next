---
import Layout from "../../layouts/Layout.astro";
import Icon from "../../components/Icon.astro";
import ProjectDiagram from "../../components/ProjectDiagram.astro";
import { projects } from "../../data/projects";
export function getStaticPaths() {
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}
const { project } = Astro.props;
const next =
  projects[
    (projects.findIndex((p) => p.slug === project.slug) + 1) % projects.length
  ];
---

<Layout
  title={`${project.name} — Harish Thangadurai`}
  description={project.description}
>
  <article class="container project-page">
    <a class="quiet-link" href="/#work">← Back to selected work</a><header
      class="page-heading"
    >
      <p class="eyebrow">{project.category}</p><h1>{project.headline}</h1><p>
        {project.description}
      </p><ul class="tag-list">
        {project.tags.map((tag) => <li>{tag}</li>)}
      </ul><a class="button button-primary" href={project.repo}
        ><Icon name="github" size={19} /> Explore the repository <Icon
          name="arrow"
          size={18}
        /></a>
    </header><ProjectDiagram type={project.slug} />
    <div class="project-story">
      <section>
        <p class="eyebrow">01 / THE PROBLEM</p><h2>What this solves.</h2><p>
          {project.problem}
        </p>
      </section><section>
        <p class="eyebrow">02 / THE APPROACH</p><h2>
          How it fits together.
        </h2><ol class="approach-list">
          {project.approach.map((point) => <li>{point}</li>)}
        </ol>
      </section><section>
        <p class="eyebrow">03 / THE TAKEAWAY</p><h2>
          Why I keep building it.
        </h2><p>{project.takeaway}</p>
      </section>
    </div><div class="project-next">
      <a class="quiet-link" href="/projects/">View all projects</a><a
        href={`/projects/${next.slug}/`}
        ><span class="mono muted">NEXT PROJECT</span><h3>
          {next.name}
          <Icon name="arrow" size={22} />
        </h3></a>
    </div>
  </article>
</Layout>
