---
import Icon from "./Icon.astro";
const activities = [
  {
    title: "Run applications",
    text: "I use Proxmox, Talos Linux, and Kubernetes to run self-hosted services, with Longhorn for persistent storage.",
  },
  {
    title: "Automate deployments",
    text: "GitHub Actions builds container images. Helm packages applications, and Argo CD keeps the cluster in sync with Git.",
  },
  {
    title: "Monitor & troubleshoot",
    text: "Prometheus and Grafana show metrics and dashboards. Loki and Alloy collect logs to help investigate problems.",
  },
];
---

<aside class="homelab-overview" aria-labelledby="homelab-heading">
  <div class="homelab-intro">
    <h3 id="homelab-heading">My homelab: a place to learn by doing</h3>
    <p>
      A homelab is a personal server environment. Mine lets me run applications,
      try infrastructure tools, and practise operating systems outside work.
    </p>
  </div>
  <div class="homelab-activities">
    {
      activities.map((activity) => (
        <div>
          <>
            <h4>{activity.title}</h4>
            <p>{activity.text}</p>
          </>
        </div>
      ))
    }
  </div>
  <a class="quiet-link" href="/projects/homelab-ops/"
    >Explore my Kubernetes setup <Icon name="arrow" size={18} /></a
  >
</aside>
