---
import Icon from "./Icon.astro";
const activities = [
  {
    icon: "server" as const,
    title: "Run",
    text: "I use Proxmox, Talos Linux, and Kubernetes to run self-hosted services, with Longhorn for persistent storage.",
  },
  {
    icon: "deploy" as const,
    title: "Deploy",
    text: "GitHub Actions builds container images. Helm packages applications, and Argo CD keeps the cluster in sync with Git.",
  },
  {
    icon: "activity" as const,
    title: "Observe",
    text: "Prometheus and Grafana show metrics and dashboards. Loki and Alloy collect logs to help investigate problems.",
  },
  {
    icon: "code" as const,
    title: "Experiment",
    text: "I try new tools, explore stateful workloads and networking, and practise recovery when things don’t go to plan.",
  },
];
---

<aside class="homelab-overview" aria-labelledby="homelab-heading">
  <div class="homelab-intro">
    <h3 id="homelab-heading">Putting that curiosity into practice</h3>
    <p>My homelab is where I explore these ideas hands-on.</p>
  </div>
  <ol class="homelab-activities">
    {
      activities.map((activity, index) => (
        <li class="homelab-step">
          <div class="homelab-node" aria-hidden="true">
            <Icon name={activity.icon} size={25} />
            <span class="mono">0{index + 1}</span>
          </div>
          <div class="homelab-step-copy">
            <h4>{activity.title}</h4>
            <p>{activity.text}</p>
          </div>
        </li>
      ))
    }
  </ol>
  <a
    class="quiet-link"
    href="/projects/homelab-ops/"
    >Explore my Kubernetes setup <Icon name="arrow" size={18} /></a
  >
</aside>
