---
import { profile } from "../data/profile";
import Icon from "./Icon.astro";
---

<section
  id="contact"
  class="contact-section container"
  aria-labelledby="contact-heading"
>
  <div>
    <p class="eyebrow">06 / GET IN TOUCH</p><h2 id="contact-heading">
      Contact
    </h2><p>
      Infrastructure, an interesting challenge, or something you've been
      building.<br class="desktop-break" /> I'd love to hear about it.
    </p>
  </div>
  <div class="contact-links">
    <a class="email-link" href={`mailto:${profile.email}`}
      >{profile.email}<Icon name="arrow" size={26} /></a
    ><div class="contact-secondary">
      <button class="copy-button" data-copy-email={profile.email}
        ><Icon name="copy" size={16} /> Copy email</button
      ><a href={profile.linkedin}
        >Connect on LinkedIn <Icon name="arrow" size={16} /></a
      >
    </div><span
      id="copy-status"
      class="copy-status"
      role="status"
      aria-live="polite"></span>
  </div>
</section>
