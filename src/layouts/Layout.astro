---
import "@fontsource-variable/manrope";
import "@fontsource-variable/jetbrains-mono";
import "../styles/global.css";
import Icon from "../components/Icon.astro";
import { profile } from "../data/profile";
interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}
const {
  title = "Harish Thangadurai — Site Reliability Engineer",
  description = "Site Reliability Engineer at NielsenIQ. Kubernetes, GitOps, observability, automation, and lessons from a hands-on homelab.",
  noindex = false,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const onHome = Astro.url.pathname === "/";
const nav = [
  ["Work", "work"],
  ["Journey", "journey"],
  ["About", "about"],
  ["Writing", "writing"],
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" /><meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    />
    <title>{title}</title><meta name="description" content={description} /><meta
      name="theme-color"
      content="#0c1017"
    />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" /><link
      rel="canonical"
      href={canonical}
    />
    <meta property="og:type" content="website" /><meta
      property="og:title"
      content={title}
    /><meta property="og:description" content={description} /><meta
      property="og:url"
      content={canonical}
    />
    <meta name="twitter:card" content="summary" /><meta
      name="twitter:title"
      content={title}
    /><meta name="twitter:description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="container header-inner">
        <a href="/" class="brand" aria-label="Harish — home"
          ><span class="brand-symbol" aria-hidden="true">h<span>:</span></span
          ><span class="brand-name"
            >harish<span class="muted"> / </span><span class="mono">sre</span
            ></span
          ></a
        >
        <nav aria-label="Main navigation" id="navigation" class="navigation">
          {
            nav.map(([label, id]) => (
              <a href={`${onHome ? "" : "/"}#${id}`} data-section={id}>
                {label}
              </a>
            ))
          }
          <a href={`${onHome ? "" : "/"}#contact`} class="nav-contact"
            >Let's talk <Icon name="arrow" size={16} /></a
          >
        </nav>
        <button
          class="menu-button"
          type="button"
          aria-label="Open navigation"
          aria-expanded="false"
          aria-controls="navigation"><Icon name="menu" /></button
        >
      </div>
    </header>
    <main id="main"><slot /></main>
    <footer class="container site-footer">
      <a href="/" class="footer-signature">harish<span>_</span></a><span
        class="footer-note">Built with care. Always a work in progress.</span
      ><div>
        <a href={profile.github} aria-label="Harish on GitHub"
          ><Icon name="github" size={19} /></a
        ><a href={profile.linkedin} aria-label="Harish on LinkedIn"
          ><Icon name="linkedin" size={19} /></a
        ><a href={`mailto:${profile.email}`} aria-label="Email Harish"
          ><Icon name="mail" size={19} /></a
        ><a class="back-top" href="#main" aria-label="Back to top">↑</a>
      </div>
    </footer>
    <script>
      const toggle = document.querySelector<HTMLButtonElement>(".menu-button");
      const nav = document.querySelector<HTMLElement>("#navigation");
      function closeMenu() {
        toggle?.setAttribute("aria-expanded", "false");
        toggle?.setAttribute("aria-label", "Open navigation");
        nav?.classList.remove("is-open");
      }
      toggle?.addEventListener("click", () => {
        const open = toggle.getAttribute("aria-expanded") !== "true";
        toggle.setAttribute("aria-expanded", String(open));
        toggle.setAttribute(
          "aria-label",
          open ? "Close navigation" : "Open navigation",
        );
        nav?.classList.toggle("is-open", open);
      });
      nav
        ?.querySelectorAll("a")
        .forEach((a) => a.addEventListener("click", closeMenu));
      document.addEventListener("keydown", (e) => {
        if (
          e.key === "Escape" &&
          toggle?.getAttribute("aria-expanded") === "true"
        ) {
          closeMenu();
          toggle.focus();
        }
      });
      matchMedia("(min-width: 761px)").addEventListener("change", closeMenu);
      document
        .querySelectorAll<HTMLButtonElement>("[data-copy-email]")
        .forEach((button) =>
          button.addEventListener("click", async () => {
            const status = document.getElementById("copy-status");
            try {
              await navigator.clipboard.writeText(
                button.dataset.copyEmail || "",
              );
              if (status) status.textContent = "Email address copied.";
            } catch {
              if (status)
                status.textContent = "Select the email address to copy it.";
            }
          }),
        );
      const sections = document.querySelectorAll<HTMLElement>("section[id]");
      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              document
                .querySelectorAll<HTMLAnchorElement>("[data-section]")
                .forEach((a) => {
                  if (a.dataset.section === entry.target.id)
                    a.setAttribute("aria-current", "location");
                  else a.removeAttribute("aria-current");
                });
            }
          }
        },
        { rootMargin: "-15% 0px -65% 0px" },
      );
      sections.forEach((section) => observer.observe(section));
    </script>
  </body>
</html>
